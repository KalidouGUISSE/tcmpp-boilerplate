<view class="app-shell">
  <scroll-view class="screen-scroll" scroll-y="true" show-scrollbar="false">
    <view class="demo-banner">MODE DÉMONSTRATION · AUCUN TRANSFERT RÉEL</view>
    <view class="page-header"><text class="page-title">Historique et suivi</text><text class="link" bindtap="openFailures">À vérifier ({{failedCount}})</text></view>
    <view class="filter-row"><text class="filter-pill {{filter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="setFilter">Tous</text><text class="filter-pill {{filter === 'success' ? 'filter-active' : ''}}" data-filter="success" bindtap="setFilter">Réussis</text><text class="filter-pill {{filter === 'pending' ? 'filter-active' : ''}}" data-filter="pending" bindtap="setFilter">En attente</text><text class="filter-pill {{filter === 'failed' ? 'filter-active' : ''}}" data-filter="failed" bindtap="setFilter">Échoués</text></view>
    <view wx:if="{{items.length === 0}}" class="empty-card"><text class="empty-title">Aucune opération</text><text class="muted">Les paiements apparaîtront ici.</text></view>
    <view class="payment-row history-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openPayment"><view class="avatar">{{item.avatarText}}</view><view class="row-main"><text class="row-sub">{{item.dateLabel}}</text><text class="row-title">{{item.name}}</text><text class="row-sub">{{item.amountLabel}} FCFA</text></view><text class="badge {{item.status === 'success' ? 'badge-green' : item.status === 'failed' ? 'badge-red' : 'badge-orange'}}">{{item.statusLabel}}</text></view>
    <view class="mode-note">Historique fictif pour la présentation. Les références DEMO ne correspondent pas à des transactions réelles.</view>
  </scroll-view>
  <autopay-tabs active="history" />
</view>
