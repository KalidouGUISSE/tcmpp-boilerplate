<view class="app-shell">
  <app-nav-bar title="Accueil" showBack="{{ false }}" />
  <scroll-view class="screen-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="brand-header"><view class="brand-mark">✿</view><view class="brand-name">Max it <text>AutoPay</text></view><view class="notification" bindtap="openFailures"><image class="header-icon" src="/icons/Tableau-de-bord/bell.svg" mode="aspectFit" /><text wx:if="{{lateCount}}" class="notification-count">{{lateCount}}</text></view></view>
    <view class="welcome"><text class="title">Bonjour, {{userName}} 👋</text><text class="muted">Votre équipe travaille, vous avancez.</text></view>
    <view class="balance-card"><view class="balance-kicker">Budget récurrent mensuel estimé</view><view class="balance-amount">{{monthTotal}} <text>FCFA</text></view><view class="balance-foot"><image class="people-icon" src="/icons/Paiements/circle-dollar-sign.svg" mode="aspectFit" />{{activeCount}} bénéficiaires actifs</view><view class="balance-people-badge"><image src="/icons/Navigation/users.svg" mode="aspectFit" /></view></view>
    <view wx:if="{{nextPayment}}" class="next-card" data-id="{{nextPayment.id}}" bindtap="openPayment"><view><text class="card-label">Prochaine échéance</text><text class="next-date">{{nextPayment.dateLabel}}</text><text class="muted small">{{nextPayment.name}} · {{nextPayment.amountLabel}} FCFA</text></view><image class="calendar-icon" src="/icons/Paiements/calendar-clock.svg" mode="aspectFit" /></view>
    <view class="stats-row"><view class="stat-card"><text class="stat-number">{{activeCount}}</text><text class="stat-label">Bénéficiaires</text></view><view class="stat-card"><text class="stat-number">{{upcomingCount}}</text><text class="stat-label">À venir</text></view><view class="stat-card alert-stat" bindtap="openFailures"><text class="stat-number">{{lateCount}}</text><text class="stat-label">À vérifier</text></view></view>
    <view class="main-cta-wrap">
      <button class="primary-button main-cta" bindtap="openSchedule">
        <image class="button-icon" src="/icons/Actions/plus.svg" mode="aspectFit" />
        <text>Programmer un paiement</text>
      </button>
    </view>
    <view class="section-heading"><text>Paiements à venir</text></view>
    <view wx:if="{{payments.length === 0}}" class="empty-card"><image class="empty-icon" src="/icons/Navigation/calendar-days.svg" mode="aspectFit" /><text class="empty-title">Aucun paiement programmé</text><text class="muted">Commencez par créer votre première échéance.</text><button class="outline-button" bindtap="openSchedule">Ajouter mon premier paiement</button></view>
    <view class="payment-row" wx:for="{{payments}}" wx:key="id" data-id="{{item.id}}" bindtap="openPayment"><view class="avatar"><image wx:if="{{item.avatarImage}}" class="avatar-image" src="{{item.avatarImage}}" mode="aspectFill" /><text wx:else>{{item.avatarText}}</text></view><view class="row-main"><text class="row-title">{{item.name}}</text><text class="row-sub">{{item.amountLabel}} FCFA · {{item.dateLabel}}</text></view><text class="badge badge-green">{{item.statusLabel}}</text></view>
    <view class="quick-link" bindtap="openEmployees"><image class="quick-icon" src="/icons/Navigation/users.svg" mode="aspectFit" /><text>Gérer mes bénéficiaires</text><image class="chevron-icon" src="/icons/Navigation/chevron-right.svg" mode="aspectFit" /></view>
  </scroll-view>
  <autopay-tabs active="home" />
</view>
