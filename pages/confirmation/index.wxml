<view class="app-shell">
  <scroll-view class="screen-scroll" scroll-y="true" show-scrollbar="false">
    <view class="page-header"><view class="back-button" bindtap="back"><image class="back-icon" src="/icons/Navigation/arrow-left.svg" mode="aspectFit" /></view><text class="page-title">{{confirmed ? 'Confirmation' : 'Vérifier la programmation'}}</text></view>
    <view wx:if="{{!confirmed}}">
      <view class="stepper"><view class="step done"><image class="status-icon" src="/icons/Statuts/circle-check.svg" mode="aspectFit" /><label>Détails</label></view><view class="step-line done-line"></view><view class="step active"><text>2</text><label>Récapitulatif</label></view><view class="step-line"></view><view class="step"><text>3</text><label>Confirmation</label></view></view>
      <view class="summary-card"><view class="summary-person"><view class="avatar large"><image wx:if="{{employee.avatarImage}}" class="avatar-image" src="{{employee.avatarImage}}" mode="aspectFill" /><text wx:else>{{employee.avatarText}}</text></view><view><text class="row-title">{{employee.name}}</text><text class="row-sub">{{employee.phone}}</text></view></view><view class="summary-line"><text>Montant</text><text>{{amountLabel}} FCFA</text></view><view class="summary-line"><text>Fréquence</text><text>{{draft.frequency}}</text></view><view class="summary-line"><text>Date de début</text><text>{{draft.startDate}}</text></view><view class="summary-line"><text>Date de fin</text><text>{{draft.endDate || 'Aucune'}}</text></view><view class="summary-line"><text>Prochaine échéance</text><text>{{dueLabel}}</text></view><view class="fee-note"><image class="status-icon" src="/icons/Securite-et-assistance/info.svg" mode="aspectFit" /><view><text>Frais de transaction</text><text class="row-sub">Frais à confirmer par le service de paiement</text></view></view><view class="mode-note">Confirmer enregistre une échéance de démonstration. Cela ne déclenche aucun transfert.</view><view class="consent-row" bindtap="toggleConsent"><view class="checkbox {{consent ? 'checked' : ''}}">{{consent ? '✓' : ''}}</view><text>Je confirme les informations et comprends qu'il s'agit d'une démonstration.</text></view></view>
    </view>
    <view wx:else class="success-screen"><image class="success-icon" src="/icons/Statuts/circle-check.svg" mode="aspectFit" /><text class="title">Programmation enregistrée</text><text class="muted center">Prochaine échéance : {{payment.dateLabel}}</text><text class="row-sub">Référence de démonstration : {{payment.ref}}</text><view class="mode-note">Mode démonstration — aucune transaction réelle n'a été exécutée.</view><button class="primary-button" bindtap="openCalendar">Voir dans le calendrier</button></view>
  </scroll-view>
  <button wx:if="{{!confirmed}}" class="primary-button bottom-action" bindtap="confirm">Confirmer la programmation</button>
</view>
