<view class="app-shell">
  <app-nav-bar safeAreaOnly="{{ true }}" />
  <scroll-view class="screen-scroll" scroll-y="true" show-scrollbar="false">
    <view class="page-header"><view class="back-button" bindtap="back"><image class="back-icon" src="/icons/Navigation/arrow-left.svg" mode="aspectFit" /></view><text class="page-title">Paiements à vérifier</text></view>
    <view class="warning-card"><image class="warning-icon" src="/icons/Statuts/triangle-alert.svg" mode="aspectFit" /><view><text class="row-title">Vérifiez avant toute nouvelle tentative</text><text class="row-sub">En cas de statut incertain, ne relancez pas le paiement.</text></view></view>
    <view wx:if="{{items.length === 0}}" class="empty-card"><image class="success-icon" src="/icons/Statuts/circle-check.svg" mode="aspectFit" /><text class="empty-title">Aucun paiement échoué</text><text class="muted">Aucune action n'est nécessaire.</text></view>
    <view class="failure-card" wx:for="{{items}}" wx:key="id"><view class="failure-top"><view class="avatar"><image wx:if="{{item.avatarImage}}" class="avatar-image" src="{{item.avatarImage}}" mode="aspectFill" /><text wx:else>{{item.avatarText}}</text></view><view class="row-main"><text class="row-title">{{item.name}}</text><text class="row-sub">{{item.amountLabel}} FCFA · {{item.dateLabel}}</text><text class="error-copy">{{item.reason}}</text></view><text class="badge badge-red">Échoué</text></view><text wx:if="{{item.verificationMessage}}" class="verification-copy">{{item.verificationMessage}}</text><button wx:if="{{!item.verified}}" class="outline-button full-button" data-id="{{item.id}}" bindtap="verify">Vérifier le paiement</button><button wx:if="{{item.verified}}" class="primary-button full-button" data-id="{{item.id}}" bindtap="retry">Simuler une nouvelle tentative</button><text class="link detail-link" data-id="{{item.id}}" bindtap="detail">Voir le détail</text></view>
    <view class="mode-note">La vérification et les tentatives sont simulées. Aucun transfert ne sera lancé depuis cette application.</view>
  </scroll-view>
  <autopay-tabs active="history" />
</view>
