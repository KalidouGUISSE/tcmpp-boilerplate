page {
  height: 100%;
  background: #f5f7f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.app-shell { height: 100vh; display: flex; flex-direction: column; background: #f5f7f8; }
.screen-scroll { display: block; flex: 1; min-height: 0; height: auto; white-space: normal; }
.page-header { min-height: 102rpx; padding: 0 28rpx; display: flex; align-items: center; background: #fff; border-bottom: 1rpx solid #edf0f2; }
.back-button { width: 56rpx; height: 56rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.back-icon { width: 40rpx; height: 40rpx; }
.page-title { min-width: 0; flex: 1; margin-left: 15rpx; color: #182f3d; font-size: 31rpx; font-weight: 700; }

.search-box { height: 76rpx; margin: 18rpx 28rpx 20rpx; padding: 0 20rpx; display: flex; align-items: center; box-sizing: border-box; border-radius: 40rpx; background: #f0f3f4; }
.search-icon { width: 36rpx; height: 36rpx; flex: none; margin-right: 12rpx; }
.search-box input { min-width: 0; flex: 1; font-size: 24rpx; color: #263d4b; }
.beneficiary-filters { display: flex; margin: 0 28rpx 16rpx; }
.beneficiary-filters .filter-pill { min-width: 0; flex: 1; margin-left: 10rpx; padding: 13rpx 6rpx; border: 1rpx solid #e2e8e9; border-radius: 30rpx; background: #fff; color: #53636d; text-align: center; font-size: 20rpx; white-space: nowrap; }
.beneficiary-filters .filter-pill:first-child { margin-left: 0; }
.beneficiary-filters .filter-pill.filter-active { border-color: #f47700; background: #f47700; color: #fff; font-weight: 700; }

.beneficiary-row { min-height: 0; margin: 0 28rpx; padding: 22rpx 0; display: flex; align-items: center; border-bottom: 1rpx solid #e5eaec; }
.employee-avatar { width: 92rpx; height: 92rpx; flex: none; overflow: hidden; border: 3rpx solid #f0f5f3; border-radius: 50%; background: #e8f1ee; display: flex; align-items: center; justify-content: center; }
.avatar-image { width: 100%; height: 100%; border-radius: 50%; }
.avatar-fallback { color: #087d57; font-size: 25rpx; font-weight: 700; }
.employee-main { min-width: 0; flex: 1; margin-left: 18rpx; display: flex; flex-direction: column; }
.employee-title-line { min-width: 0; display: flex; align-items: center; }
.beneficiary-name { min-width: 0; flex: 1; overflow: hidden; color: #1c3443; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.employee-title-line .badge { flex: none; margin-left: 8rpx; padding: 7rpx 12rpx; border-radius: 24rpx; font-size: 19rpx; font-weight: 700; }
.badge-green { color: #148052; background: #dcf7e9; }
.badge-gray { color: #596873; background: #edf0f2; }
.row-sub { margin-top: 5rpx; color: #788791; font-size: 22rpx; line-height: 1.35; }
.beneficiary-actions { display: flex; flex-wrap: wrap; margin-top: 8rpx; padding-top: 10rpx; border-top: 1rpx solid #f0f2f3; }
.beneficiary-actions .link { margin-right: 22rpx; color: #087d57; font-size: 21rpx; font-weight: 650; }
.beneficiary-actions .subdued { color: #77848e; }

.beneficiary-empty { margin: 24rpx 28rpx; padding: 30rpx 22rpx; border-radius: 20rpx; background: #fff; display: flex; align-items: center; flex-direction: column; text-align: center; }
.beneficiary-empty > * { margin-top: 9rpx; }
.empty-icon { width: 46rpx; height: 46rpx; }
.empty-title { color: #233d4a; font-size: 26rpx; font-weight: 700; }
.muted { color: #73818d; font-size: 23rpx; }
.outline-button { height: 80rpx; margin-top: 12rpx; padding: 0 24rpx; border: 2rpx solid #b7d9ca; border-radius: 18rpx; background: #fff; color: #087d57; font-size: 23rpx; font-weight: 700; line-height: 78rpx; }
.outline-button::after, .primary-button::after { border: 0; }

.employee-footer { flex-shrink: 0; padding: 12rpx 28rpx 18rpx; border-top: 1rpx solid #edf0f2; background: #f5f7f8; }
.add-beneficiary-button { width: 100%; height: 92rpx; margin: 0; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 0; border-radius: 22rpx; background: #f47700; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 92rpx; box-shadow: 0 7rpx 15rpx rgba(244, 119, 0, .14); }
.button-icon { width: 32rpx; height: 32rpx; flex: none; margin-right: 12rpx; filter: brightness(0) invert(1); }
