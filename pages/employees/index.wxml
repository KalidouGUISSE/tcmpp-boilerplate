<view class="app-shell">
  <app-nav-bar safeAreaOnly="{{ true }}" />
  <scroll-view class="screen-scroll" scroll-y="true" show-scrollbar="false">
    <view class="page-header">
      <view class="back-button" bindtap="back">
        <image class="back-icon" src="/icons/Navigation/arrow-left.svg" mode="aspectFit" />
      </view>
      <text class="page-title">Mes bénéficiaires</text>
    </view>

    <view class="search-box">
      <image class="search-icon" src="/icons/Employes/search.svg" mode="aspectFit" />
      <input placeholder="Rechercher un bénéficiaire…" value="{{query}}" bindinput="onSearch" />
    </view>

    <view class="beneficiary-filters">
      <view wx:for="{{filters}}" wx:key="id" class="filter-pill {{statusFilter === item.id ? 'filter-active' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter">{{item.label}}</view>
    </view>

    <view wx:if="{{employees.length === 0}}" class="empty-card beneficiary-empty">
      <image class="empty-icon" src="/icons/Employes/user-round.svg" mode="aspectFit" />
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="muted">{{emptyMessage}}</text>
      <button wx:if="{{totalCount === 0}}" class="outline-button" bindtap="addEmployee">Ajouter un bénéficiaire</button>
    </view>

    <view class="employee-row beneficiary-row" wx:for="{{employees}}" wx:key="id">
      <view class="avatar large employee-avatar">
        <image wx:if="{{item.avatarImage}}" class="avatar-image" src="{{item.avatarImage}}" mode="aspectFill" data-id="{{item.id}}" binderror="onAvatarError" />
        <text wx:else class="avatar-fallback">{{item.avatarText}}</text>
      </view>
      <view class="row-main employee-main">
        <view class="employee-title-line">
          <text class="row-title beneficiary-name">{{item.name}}</text>
          <text class="badge {{item.active ? 'badge-green' : 'badge-gray'}}">{{item.active ? 'Actif' : 'Inactif'}}</text>
        </view>
        <text class="row-sub">{{item.phone}}</text>
        <text class="row-sub">{{item.amountLabel}} FCFA · {{item.frequency}}</text>
        <text wx:if="{{item.nextDueLabel}}" class="row-sub">Prochaine échéance : {{item.nextDueLabel}}</text>
        <view class="beneficiary-actions">
          <text wx:if="{{item.active}}" class="link" data-id="{{item.id}}" bindtap="schedule">Programmer</text>
          <text class="link subdued" data-id="{{item.id}}" bindtap="editEmployee">Modifier</text>
          <text class="link subdued" data-id="{{item.id}}" bindtap="toggleEmployee">{{item.active ? 'Désactiver' : 'Réactiver'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="employee-footer">
    <button class="primary-button add-beneficiary-button" bindtap="addEmployee">
      <image class="button-icon" src="/icons/Actions/plus.svg" mode="aspectFit" />
      <text>Ajouter un bénéficiaire</text>
    </button>
  </view>
  <autopay-tabs active="employees" />
</view>
