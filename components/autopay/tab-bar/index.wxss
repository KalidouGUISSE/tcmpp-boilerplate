.bottom-nav {
  position: relative;
  flex-shrink: 0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #e9edef;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.nav-item {
  width: 20%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #829099;
  font-size: 19rpx;
  gap: 2rpx;
}

.nav-create-item {
  width: 20%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-create-button {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #f47700;
  box-shadow: 0 5rpx 12rpx rgba(244, 119, 0, .22);
}

.nav-create-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
  filter: brightness(0) invert(1);
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%) invert(62%) sepia(8%) saturate(559%) hue-rotate(158deg) brightness(92%) contrast(87%);
}
.nav-active { color: #f47700; font-weight: 700; }
.nav-active .nav-icon {
  filter: brightness(0) saturate(100%) invert(45%) sepia(90%) saturate(1618%) hue-rotate(1deg) brightness(101%) contrast(105%);
}
