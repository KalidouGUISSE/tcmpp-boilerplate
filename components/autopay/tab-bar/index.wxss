.bottom-nav {
  position: relative;
  flex-shrink: 0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #e9edef;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.nav-item {
  width: 25%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #829099;
  font-size: 19rpx;
  gap: 2rpx;
}

.nav-icon { font-size: 39rpx; line-height: 1.1; }
.nav-active { color: #f47700; font-weight: 700; }
